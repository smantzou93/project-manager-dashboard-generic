# Template for .env -- copy happens automatically in ./scripts/preflight.sh,
# which substitutes real random values for the __GENERATED_*__ placeholders.
#
# THIS REPO IS PUBLIC. Commit this template; never commit .env itself.
# .env is gitignored and written chmod 600.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=pmdash
POSTGRES_PASSWORD=__GENERATED_DB_PASSWORD__
POSTGRES_DB=pmdash
POSTGRES_PORT=5432

# Consumed by Drizzle and by the Python ingestion service. Host-side URL: the
# port above is published on loopback by docker-compose.
DATABASE_URL=postgresql://pmdash:__GENERATED_DB_PASSWORD__@127.0.0.1:5432/pmdash

# --- Web / BFF --------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_SECRET=__GENERATED_APP_SECRET__

# --- Logging ----------------------------------------------------------------
# debug | info | warn | error. Structured JSON lands in ./logs for agent triage.
LOG_LEVEL=info
LOG_DIR=./logs

# --- Ingestion --------------------------------------------------------------
# Cap on uploaded CSV size, in megabytes.
INGEST_MAX_UPLOAD_MB=50
INGEST_UPLOAD_DIR=./.data/uploads
