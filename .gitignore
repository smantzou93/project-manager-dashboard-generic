# dependencies
node_modules/
packages/db/node_modules/
/.pnp
.pnp.js

# python (ingestion service)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# runtime artifacts -- structured logs and uploaded CSVs stay local
/logs/
/.data/

# testing
/coverage

# next.js
/.next/
/out/
apps/web/.next/
apps/web/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Next.js
.next/
.turbo/

# Playwright
test-results/
playwright-report/

# Screenshot baselines: only the Linux set is committed.
#
# Linux is authoritative -- font rasterisation differs from macOS, so a
# locally captured baseline can never match CI. Committing the macOS set as
# well meant 1.2MB of churn on every UI change for files nothing compares
# against. Generate the real ones with `npm run baselines:linux`.
tests/visual/__baselines__/*
!tests/visual/__baselines__/linux/
