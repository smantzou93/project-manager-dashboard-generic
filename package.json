{
  "name": "project-manager-dashboard-generic",
  "version": "0.1.0",
  "private": true,
  "description": "Cloneable, agent-editable project management dashboard: Next.js + Drizzle/Postgres + Python ingestion",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preflight": "./scripts/preflight.sh",
    "dev": "./scripts/dev.sh",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "./scripts/db-reset.sh",
    "db:generate": "npm run --workspace @pmdash/db generate",
    "db:migrate": "npm run --workspace @pmdash/db migrate",
    "db:seed": "npm run --workspace @pmdash/db seed",
    "db:preset": "npm run --workspace @pmdash/db preset --",
    "db:studio": "npm run --workspace @pmdash/db studio",
    "web": "npm run --workspace @pmdash/web dev",
    "build": "npm run --workspace @pmdash/web build",
    "//gates": "These four are what pre-commit and CI both run. Keep them fast and keep them honest -- an earlier typecheck script ended in `|| true`, which made it report success on every error.",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --pretty false && tsc -p tests/visual/tsconfig.json --pretty false && tsc -p apps/web/tsconfig.json --pretty false",
    "//tests": "`test` is the fast pure suite. `test:integration` needs Postgres and the pinned fixture; `test:visual` additionally needs the web app and a browser.",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:visual": "playwright test --project=desktop --project=dark --project=mobile",
    "test:contract": "playwright test --project=api",
    "openapi": "curl -fsS http://localhost:3000/api/openapi.json | python3 -m json.tool",
    "test:visual:update": "playwright test --update-snapshots",
    "screenshots": "./scripts/screenshots.sh",
    "//ingest": "The Python importer. Uses the venv in apps/ingestion so it works without an activated shell.",
    "ingest": "apps/ingestion/.venv/bin/python -m pmdash_ingest",
    "ingest:setup": "python3 -m venv apps/ingestion/.venv && apps/ingestion/.venv/bin/pip install -q -e 'apps/ingestion[dev]'",
    "ingest:test": "apps/ingestion/.venv/bin/python -m pytest apps/ingestion/tests -q",
    "ingest:lint": "apps/ingestion/.venv/bin/ruff check apps/ingestion",
    "hooks:install": "git config core.hooksPath .githooks && echo 'git hooks enabled (.githooks)'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "overrides": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
